# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# PostgreSQL
POSTGRES_USER=acadeval
POSTGRES_PASSWORD=
POSTGRES_DB=acadeval
DATABASE_URL=

# Authentication — replace before sharing or deploying the application.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Optional external services
GEMINI_API_KEY=
SEMANTIC_SCHOLAR_KEY=
GITHUB_TOKEN=
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_ASSIGNMENT_ID=0
MOODLE_FACULTY_USER_ID=

# Email notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AcadEval+ Platform

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Redis, GROBID, and file storage
REDIS_URL=redis://redis:6379/0
GROBID_URL=http://grobid:8070
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=500

# Application
APP_ENV=development
# Optional first HOD account; leave email blank to skip bootstrapping.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DEPARTMENT=CSE
# Comma-separated list; wildcard origins are intentionally unsupported with credentials.
FRONTEND_ORIGIN=http://localhost:5173
